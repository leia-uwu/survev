{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "paths": {
      "@/sdk.ts": ["./src/sdk/sdk-manager.ts"],
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.js",
    "./stats/**/*.ts",
    "./stats/**/*.js",
    "./stats/**/*.svelte",
    "../shared/",
    "./atlas-builder/**/*.ts",
    "./building-editor/**/*.ts",
    "vite.config.ts",
    "./global.d.ts"
  ]
}
